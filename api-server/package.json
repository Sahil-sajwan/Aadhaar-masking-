{
  "name": "aadhaar-api-server",
  "version": "1.0.0",
  "description": "TypeScript Node.js API Server for Aadhaar Masking Task Dispatcher",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/public && cp -r src/public/* dist/public/",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
